# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.bin

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo
.agent/
.workbuddy/

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
bin/

# 开发目录不入库（用户决定 2026-09-01：test/、build/、docs/ 仅本地维护）
/test/
/build/
/docs/

# Logs
logs/
*.log

# Database files
*.db
*.db-shm
*.db-wal

# Config files with secrets
conf/authcode*
conf/*-test.toml
conf/*-local.toml

# Temporary files
tmp/
temp/
*.tmp

# Vite temporary config files
*.timestamp-*.mjs

# Backup
backup_*/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg

# Node.js
node_modules/

# Frontend build
web-pm/dist/
web-ps/dist/
cmd/seeinps-deployer/web/build/

# Go build cache
.gocache/

# WorkBuddy workspace metadata
.workbuddy/

# 含服务器凭据的文件，禁止入库（服务器地址/账号/密码）
/README.md
/test/测试服务器信息.txt
/test/e2e/test_upgrade_linux_scratch.py
/test/legacy-scripts/

# Archives
*.zip

# Release binaries (scripts/build.sh outputs here)
/release/

# Local runtime data (seeinpm data dir when run from repo root)
/data/

# E2E runtime data & DB backups
test/e2e/runtime/*/data/*.bak*
test/e2e/runtime/ps/data/

# Embedded frontend build outputs (build.sh copies web dist here; placeholder index.html stays tracked)
internal/webui/pm/files/*
!internal/webui/pm/files/index.html
internal/webui/ps/files/*
!internal/webui/ps/files/index.html

# Windows PE resource files generated by go-winres during builds (build.sh/build-deployer.sh)
cmd/*/winres_windows_amd64.syso
cmd/*/winres_windows.syso
seeinpc/*.syso

# seeinpc 内嵌驱动（go:embed 需要，随仓库分发）
!seeinpc/resource/wintun.dll

# 回收目录（本地清理用）
.trash/

# seeinpc 运行时锁文件
seeinpc/seeinpc.lock

# e2e runtime release packages
test/e2e/runtime/pm/data/releases/
